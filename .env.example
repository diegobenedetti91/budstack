# Modelo de variáveis do site da BudStack. Copie para .env (local) ou cadastre no hPanel (produção).
# Preços, planos, recursos e regras de cobrança NÃO ficam aqui: edite em Administração no próprio site.

# ── Obrigatórias ─────────────────────────────────────────────
# Banco MySQL do site (não use o banco de nenhuma loja de cliente)
DATABASE_URL="mysql://usuario:senha@localhost:3306/budstack"

# Endereço público do site, com https e sem barra no final
SITE_URL="https://budstack.com.br"

# Seu usuário administrador, criado no build se ainda não existir.
# Senha com 10+ caracteres. Sem ADMIN_PASSWORD, uma senha aleatória aparece UMA vez no log do build.
# Depois de criado, troque a senha em Meus dados (ou "Esqueci a senha"). ADMIN_RESET_PASSWORD=1 força a senha daqui.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Diego"

# Mercado Pago da BudStack (Seu negócio → Configurações → Credenciais de produção). Opcional se usar o Asaas.
MP_ACCESS_TOKEN=""

# ── Asaas (opcional; escolha o gateway em Administração → Configurações) ──
# Chave da API (Asaas → Integrações → Chave de API). Sandbox e produção têm chaves diferentes.
ASAAS_API_KEY=""
# sandbox (testes) ou production
ASAAS_ENV="sandbox"
# Token que você define ao cadastrar o webhook no Asaas (chega no cabeçalho asaas-access-token)
ASAAS_WEBHOOK_TOKEN=""

# Libera o gateway "Simulado" (pagamentos de mentira, para testar). NUNCA ligue com clientes reais.
ALLOW_SIMULATED_PAYMENTS=""

# Senha da rotina diária de cobrança (/api/cron/billing). Gere com: openssl rand -hex 32
CRON_SECRET=""

# ── E-mail (avisos para você e e-mails para os clientes) ─────
# Hostinger: smtp.hostinger.com, porta 465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Remetente exibido (opcional). Padrão: SMTP_USER
SMTP_FROM=""
# E-mail que recebe os avisos, se não for configurado no painel
NOTIFY_EMAIL=""

# ── WhatsApp para você (CallMeBot, gratuito, só para o seu número) ──
# Passo a passo no README. Telefone com DDI, ex.: 5519999999999
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""
