# Modelo de variáveis do site da BudStack. Copie para .env (local) ou cadastre no hPanel (produção).

# ── Obrigatórias ─────────────────────────────────────────────
# Banco MySQL do site (não use o banco de nenhuma loja de cliente)
DATABASE_URL="mysql://usuario:senha@localhost:3306/budstack"

# Endereço público do site, com https e sem barra no final
SITE_URL="https://budstack.com.br"

# Segredo da sessão do painel. Gere com: openssl rand -hex 32
SESSION_SECRET=""

# Seu acesso ao painel (/admin/login). Senha com 10 ou mais caracteres.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Mercado Pago da BudStack (Seu negócio → Configurações → Credenciais de produção)
MP_ACCESS_TOKEN=""

# ── Avisos de nova assinatura ────────────────────────────────
# E-mail que recebe o aviso (o seu)
NOTIFY_EMAIL=""

# SMTP para enviar os e-mails (Hostinger: smtp.hostinger.com, porta 465)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Remetente exibido (opcional). Padrão: SMTP_USER
SMTP_FROM=""

# WhatsApp pelo CallMeBot (gratuito, envia só para o seu próprio número).
# Passo a passo no README. Telefone com DDI, ex.: 5519999999999
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# WhatsApp exibido no site para contato (só números, com DDI)
NEXT_PUBLIC_WHATSAPP="5519981687551"
